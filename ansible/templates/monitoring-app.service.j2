[Unit]
Description=Demo Linux Server Monitoring Application
After=network.target

[Service]
Type=simple
WorkingDirectory={{ app_install_dir }}
EnvironmentFile=-/etc/{{ app_service_name }}.env
ExecStart={{ app_install_dir }}/.venv/bin/python app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
